  <!-- The budget holds across retries: a deadline that passes during the delay between two attempts stops the retries.
       The only real time here is the retry delay (200 ms); the deadline sits 150 ms ahead, so the first attempt runs
       and the second does not. -->
  <munit:test name="deadline-stops-the-retries-test">
    <munit:behavior>
      <os:clear objectStore="carrier-session-store"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Log in to carrier"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:payload value='#[output application/json --- { sessionId: "S1" }]' mediaType="application/json"/></munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Search carrier shipments"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:payload value='#[output application/json --- { ids: ["SH-1"] }]' mediaType="application/json"/></munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get carrier shipment"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:error typeId="HTTP:SERVICE_UNAVAILABLE"/></munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <set-variable variableName="shipmentDate" value="2026-11-19"/>
      <set-variable variableName="deadlineMillis" value="#[output application/java --- (now() as Number {unit: 'milliseconds'}) + 150]"/>
      <try>
        <flow-ref name="list-shipments"/>
        <error-handler>
          <on-error-continue>
            <set-variable variableName="lastError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
          </on-error-continue>
        </error-handler>
      </try>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.lastError]" is='#[MunitTools::equalTo("APP:BUDGET_EXCEEDED")]'/>
      <munit-tools:verify-call processor="http:request" times="1">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get carrier shipment"/></munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

  <!-- A login that times out is 504, not 500 (mule-app MERR-3). -->
  <munit:test name="login-timeout-gives-504-test">
    <munit:enable-flow-sources>
      <munit:enable-flow-source value="shipments-api-main"/>
    </munit:enable-flow-sources>
    <munit:behavior>
      <os:clear objectStore="carrier-session-store"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Log in to carrier"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:error typeId="HTTP:TIMEOUT"/></munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <http:request config-ref="test-client-config" method="GET" path="/api/shipments">
        <http:query-params>#[{ date: "2026-11-19" }]</http:query-params>
        <http:response-validator><http:success-status-code-validator values="100..599"/></http:response-validator>
      </http:request>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(504)]"/>
      <munit-tools:assert-that expression="#[payload.code]" is='#[MunitTools::equalTo("UPSTREAM_TIMEOUT")]'/>
    </munit:validation>
  </munit:test>

  <!-- A call that keeps timing out ends, after its retries, as the carrier timeout (504), not as unavailable (503). -->
  <munit:test name="exhausted-timeout-gives-carrier-timeout-test">
    <munit:behavior>
      <os:clear objectStore="carrier-session-store"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Log in to carrier"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:payload value='#[output application/json --- { sessionId: "S1" }]' mediaType="application/json"/></munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Search carrier shipments"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:payload value='#[output application/json --- { ids: ["SH-1"] }]' mediaType="application/json"/></munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get carrier shipment"/></munit-tools:with-attributes>
        <munit-tools:then-return><munit-tools:error typeId="HTTP:TIMEOUT"/></munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <set-variable variableName="shipmentDate" value="2026-11-19"/>
      <try>
        <flow-ref name="list-shipments"/>
        <error-handler>
          <on-error-continue>
            <set-variable variableName="lastError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
          </on-error-continue>
        </error-handler>
      </try>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[vars.lastError]" is='#[MunitTools::equalTo("CARRIER:TIMEOUT")]'/>
      <munit-tools:verify-call processor="http:request" times="3">
        <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get carrier shipment"/></munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>
</mule>
