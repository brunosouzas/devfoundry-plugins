<?xml version="1.0" encoding="UTF-8"?>
<!-- Circuit Breaker around a synchronous call to a dependency that slows down and fails under load.
     CLOSED: calls go through and consecutive failures are counted. OPEN: calls are not made for breaker.openSeconds; the flow
     answers at once. HALF_OPEN: after the cool-down, one trial call; success closes, failure opens again. -->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

  <!-- GET /quotes?zip=...: a freight quote. While the circuit is open, answer 503 with Retry-After at once instead of waiting. -->
  <flow name="get-freight-quote-flow">
    <http:listener config-ref="quotes-listener-config" path="/quotes" allowedMethods="GET">
      <http:response statusCode="#[vars.httpStatus default 200]">
        <http:headers><![CDATA[#[vars.responseHeaders default {}]]]></http:headers>
      </http:response>
      <http:error-response statusCode="#[vars.httpStatus default 502]">
        <http:body><![CDATA[#[payload]]]></http:body>
      </http:error-response>
    </http:listener>
    <set-variable variableName="zip" value="#[output application/java --- (attributes.queryParams.zip default '') as String]"/>
    <flow-ref name="call-carrier-rates-with-breaker-flow"/>
    <ee:transform>
      <ee:message>
        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ zip: vars.zip, price: payload.price, currency: payload.currency }]]></ee:set-payload>
      </ee:message>
    </ee:transform>
    <error-handler>
      <on-error-continue type="BREAKER:OPEN">
        <set-variable variableName="httpStatus" value="503"/>
        <set-variable variableName="responseHeaders" value="#[{ 'Retry-After': p('breaker.openSeconds') }]"/>
        <set-payload value='#[output application/json --- { zip: vars.zip, error: "Carrier rates are unavailable, try again later" }]'/>
      </on-error-continue>
    </error-handler>
  </flow>

  <!-- The breaker, without a source so MUnit can call it. Raises BREAKER:OPEN while the circuit is open. -->
  <flow name="call-carrier-rates-with-breaker-flow">
    <os:retrieve key="carrier-rates-api" objectStore="breaker-state-store" target="breaker">
      <os:default-value><![CDATA[#[output application/java --- { state: "CLOSED", failures: 0, openedAt: 0 }]]]></os:default-value>
    </os:retrieve>
    <set-variable variableName="nowSeconds" value="#[output application/java --- now() as Number]"/>
    <set-variable variableName="trial" value="#[false]"/>

    <choice>
      <!-- OPEN within the cool-down, or a HALF_OPEN trial already in flight: do not call. -->
      <when expression="#[vars.breaker.state != 'CLOSED' and (vars.nowSeconds - vars.breaker.openedAt) &lt; (p('breaker.openSeconds') as Number)]">
        <raise-error type="BREAKER:OPEN" description="#['Circuit open for carrier-rates-api since ' ++ (vars.breaker.openedAt as String)]"/>
      </when>
      <!-- Cool-down over: this request is the trial. Mark HALF_OPEN (with a fresh time) so concurrent requests keep failing fast. -->
      <when expression="#[vars.breaker.state != 'CLOSED']">
        <os:store key="carrier-rates-api" objectStore="breaker-state-store">
          <os:value><![CDATA[#[output application/java --- { state: "HALF_OPEN", failures: vars.breaker.failures, openedAt: vars.nowSeconds }]]]></os:value>
        </os:store>
        <set-variable variableName="trial" value="#[true]"/>
      </when>
    </choice>

    <try>
      <http:request doc:name="Get carrier rates" method="GET" config-ref="carrier-rates-config" path="/rates">
        <http:query-params><![CDATA[#[{ zip: vars.zip default '' }]]]></http:query-params>
      </http:request>
      <!-- Success: close the circuit and reset the count. -->
      <os:store key="carrier-rates-api" objectStore="breaker-state-store">
        <os:value><![CDATA[#[output application/java --- { state: "CLOSED", failures: 0, openedAt: 0 }]]]></os:value>
      </os:store>
      <error-handler>
        <!-- The dependency is unhealthy: count it. A failed trial, or the threshold reached, opens the circuit. -->
        <on-error-propagate type="HTTP:TIMEOUT, HTTP:CONNECTIVITY, HTTP:INTERNAL_SERVER_ERROR, HTTP:BAD_GATEWAY, HTTP:SERVICE_UNAVAILABLE, HTTP:GATEWAY_TIMEOUT">
          <set-variable variableName="failures" value="#[output application/java --- if (vars.trial) (p('breaker.failureThreshold') as Number) else (vars.breaker.failures + 1)]"/>
          <os:store key="carrier-rates-api" objectStore="breaker-state-store">
            <os:value><![CDATA[#[output application/java --- if (vars.failures >= (p('breaker.failureThreshold') as Number))
              { state: "OPEN", failures: vars.failures, openedAt: vars.nowSeconds }
            else
              { state: "CLOSED", failures: vars.failures, openedAt: 0 }]]]></os:value>
          </os:store>
          <logger level="WARN" message="#['carrier-rates-api failure ' ++ (vars.failures as String) ++ ': ' ++ (error.errorType.identifier default '')]"/>
        </on-error-propagate>
        <!-- Any other error (a 4xx, a bad request): the dependency answered, so it is healthy. Do not count it; a trial closes. -->
        <on-error-propagate>
          <choice>
            <when expression="#[vars.trial]">
              <os:store key="carrier-rates-api" objectStore="breaker-state-store">
                <os:value><![CDATA[#[output application/java --- { state: "CLOSED", failures: 0, openedAt: 0 }]]]></os:value>
              </os:store>
            </when>
          </choice>
        </on-error-propagate>
      </error-handler>
    </try>
  </flow>
</mule>
