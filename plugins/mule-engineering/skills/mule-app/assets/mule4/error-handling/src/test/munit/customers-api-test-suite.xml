    </munit:validation>
  </munit:test>

  <!-- The module's functions on their own, with their edge cases (DWTEST-1). -->
  <munit:test name="mapping-missing-name-gives-empty-name-test">
    <munit:execution>
      <munit:set-event>
        <munit:payload value='#[output application/json --- { id: "C-1002", statusCode: "S", createdAt: "20231231" }]' mediaType="application/json"/>
      </munit:set-event>
      <ee:transform>
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
import * from dwl::customer::CustomerMapping
output application/json
---
toCustomer(payload)]]></ee:set-payload></ee:message>
      </ee:transform>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.name]" is='#[MunitTools::equalTo("")]'/>
      <munit-tools:assert-that expression="#[payload.status]" is='#[MunitTools::equalTo("SUSPENDED")]'/>
      <munit-tools:assert-that expression="#[payload.since]" is='#[MunitTools::equalTo("2023-12-31")]'/>
    </munit:validation>
  </munit:test>

  <munit:test name="mapping-unknown-status-fails-test" expectedErrorType="MULE:EXPRESSION">
    <munit:execution>
      <munit:set-event>
        <munit:payload value='#[output application/json --- { id: "C-1003", statusCode: "X", createdAt: "20240105" }]' mediaType="application/json"/>
      </munit:set-event>
      <ee:transform>
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
import * from dwl::customer::CustomerMapping
output application/json
---
toCustomer(payload)]]></ee:set-payload></ee:message>
      </ee:transform>
    </munit:execution>
  </munit:test>

  <!-- A status sent as a number is converted on purpose and is not a known code (DW-7, DWTEST-1). -->
  <munit:test name="mapping-numeric-status-fails-test" expectedErrorType="MULE:EXPRESSION">
    <munit:execution>
      <munit:set-event>
        <munit:payload value='#[output application/json --- { id: "C-1003", statusCode: 1, createdAt: "20240105" }]' mediaType="application/json"/>
      </munit:set-event>
      <ee:transform>
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
import * from dwl::customer::CustomerMapping
output application/json
---
toCustomer(payload)]]></ee:set-payload></ee:message>
      </ee:transform>
    </munit:execution>
  </munit:test>

</mule>
